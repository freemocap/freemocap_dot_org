# GENERATED by go/build.mjs from go/links.csv. Do not edit by hand.
# 302 (temporary) on purpose so browsers never cache a link and we can repoint it later.

<IfModule mod_rewrite.c>
RewriteEngine On

# The public QR download page and its files are served as-is.
RewriteRule ^qr(/.*)?$ - [L]

RewriteRule ^docs/?$ https://docs.freemocap.org/ [NC,NE,L,R=302]
RewriteRule ^mocap-kit/?$ https://shop.freemocap.org/products/mocap-kit [NC,NE,L,R=302]
RewriteRule ^eye-trackers/?$ https://shop.freemocap.org/products/animal-eye-trackers [NC,NE,L,R=302]
RewriteRule ^sfn26/?$ https://forms.gle/RhhjJKbz9o8Mmbzz9 [NC,NE,L,R=302]

# Unknown or mistyped codes land on the homepage instead of a 404.
RewriteRule ^ https://freemocap.org/ [L,R=302]
</IfModule>
