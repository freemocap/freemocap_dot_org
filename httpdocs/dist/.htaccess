# IMPORTANT: Order goes external redirects, then aliases, then the generic .html rule.

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# 1. External redirects (off-site)

# 2. Internal aliases (old URLs -> current pages)
RewriteRule ^community/?$ /showcase.html [NC,L,R=301]
RewriteRule ^crypto-wallet-page(\.html)?/?$ /crypto-wallets.html [NC,L,R=301]

# 3. Generic: /foo and /foo/ -> /foo.html, when foo.html exists. Replaces the per-page rules. Works for any future page.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ /$1.html [NC,L,R=301]
</IfModule>

# Custom 404 page
ErrorDocument 404 /404.html
# Make browsers check for a newer copy of pages, styles, scripts, and data on
# every visit (a quick 304 when nothing changed), so a deploy shows up right
# away instead of whenever each browser's guessed cache time runs out.
# No ETags: on this host they never match (so every check re-downloads the
# file), while Last-Modified checks correctly return a quick 304.
FileETag None
<IfModule mod_headers.c>
  Header unset ETag
  <FilesMatch "\.(html|css|js|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
